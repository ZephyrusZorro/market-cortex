{
  "$defs": {
    "BacktestDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "backtest_v1",
          "default": "backtest_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_id": {
          "enum": [
            "momentum",
            "breakout",
            "trend_continuation",
            "pullback",
            "buy_hold",
            "equal_weight"
          ],
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Strategy Version",
          "type": "string"
        },
        "manifest_id": {
          "format": "uuid",
          "title": "Manifest Id",
          "type": "string"
        },
        "source_as_of": {
          "format": "date-time",
          "title": "Source As Of",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Symbols",
          "type": "array"
        },
        "replay_policy": {
          "default": "AS_RECORDED",
          "enum": [
            "AS_RECORDED",
            "HISTORICAL_RECONSTRUCTION"
          ],
          "title": "Replay Policy",
          "type": "string"
        },
        "publication_lag_seconds": {
          "default": 60,
          "maximum": 86400,
          "minimum": 1,
          "title": "Publication Lag Seconds",
          "type": "integer"
        },
        "interval": {
          "const": "P1D",
          "default": "P1D",
          "title": "Interval",
          "type": "string"
        },
        "adjustment_basis": {
          "const": "raw",
          "default": "raw",
          "title": "Adjustment Basis",
          "type": "string"
        },
        "universe": {
          "const": "binance_pilot_5_selected_survivors",
          "default": "binance_pilot_5_selected_survivors",
          "title": "Universe",
          "type": "string"
        },
        "capital": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0,
          "title": "Capital",
          "type": "number"
        },
        "max_positions": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Positions",
          "type": "integer"
        },
        "parameters": {
          "$ref": "#/$defs/StrategyParameters"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionPolicy"
        },
        "costs": {
          "$ref": "#/$defs/CostModel"
        },
        "sizing": {
          "$ref": "#/$defs/SizingPolicy"
        },
        "benchmark": {
          "default": "same_universe_equal_weight",
          "enum": [
            "BTCUSDT",
            "same_universe_equal_weight",
            "cash"
          ],
          "title": "Benchmark",
          "type": "string"
        },
        "annualization": {
          "const": 365,
          "default": 365,
          "title": "Annualization",
          "type": "integer"
        },
        "risk_free_rate": {
          "default": 0,
          "maximum": 0.5,
          "minimum": -0.1,
          "title": "Risk Free Rate",
          "type": "number"
        },
        "classification": {
          "default": "OWNER_RESEARCH",
          "enum": [
            "OWNER_RESEARCH",
            "SYNTHETIC_TEST"
          ],
          "title": "Classification",
          "type": "string"
        },
        "context_filter": {
          "default": "none",
          "enum": [
            "none",
            "funding_nonpositive",
            "oi_expanding"
          ],
          "title": "Context Filter",
          "type": "string"
        }
      },
      "required": [
        "strategy_id",
        "manifest_id",
        "source_as_of",
        "start",
        "end"
      ],
      "title": "BacktestDefinition",
      "type": "object"
    },
    "CostModel": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "bps_proxy_v1",
