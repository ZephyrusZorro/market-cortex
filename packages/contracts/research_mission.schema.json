          "title": "Spread Bps",
          "type": "number"
        },
        "fixed_fee": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Fixed Fee",
          "type": "number"
        }
      },
      "title": "CostModel",
      "type": "object"
