          "type": "integer"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 12,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "run_ids",
        "reason"
      ],
      "title": "EdgeEvidenceRequest",
      "type": "object"
    },
