          "maxItems": 12,
          "minItems": 1,
          "title": "Run Ids",
          "type": "array"
        },
        "study_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Study Ids",
          "type": "array"
        },
        "status": {
          "default": "HYPOTHESIS",
