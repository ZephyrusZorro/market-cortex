{
  "$defs": {
    "BacktestDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "backtest_v1",
          "default": "backtest_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_id": {
          "enum": [
            "momentum",
            "breakout",
            "trend_continuation",
            "pullback",
            "buy_hold",
            "equal_weight"
          ],
          "title": "Strategy Id",
          "type": "string"
        },
        "strategy_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Strategy Version",
          "type": "string"
        },
        "manifest_id": {
          "format": "uuid",
          "title": "Manifest Id",
          "type": "string"
        },
        "source_as_of": {
          "format": "date-time",
          "title": "Source As Of",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Symbols",
          "type": "array"
        },
        "replay_policy": {
          "default": "AS_RECORDED",
          "enum": [
            "AS_RECORDED",
            "HISTORICAL_RECONSTRUCTION"
          ],
          "title": "Replay Policy",
          "type": "string"
        },
        "publication_lag_seconds": {
          "default": 60,
          "maximum": 86400,
          "minimum": 1,
          "title": "Publication Lag Seconds",
          "type": "integer"
        },
        "interval": {
          "const": "P1D",
          "default": "P1D",
          "title": "Interval",
          "type": "string"
        },
        "adjustment_basis": {
          "const": "raw",
          "default": "raw",
          "title": "Adjustment Basis",
          "type": "string"
        },
        "universe": {
          "const": "binance_pilot_5_selected_survivors",
          "default": "binance_pilot_5_selected_survivors",
          "title": "Universe",
          "type": "string"
        },
        "capital": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0,
          "title": "Capital",
          "type": "number"
        },
        "max_positions": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Positions",
          "type": "integer"
        },
        "parameters": {
          "$ref": "#/$defs/StrategyParameters"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionPolicy"
        },
        "costs": {
          "$ref": "#/$defs/CostModel"
        },
        "sizing": {
          "$ref": "#/$defs/SizingPolicy"
        },
        "benchmark": {
          "default": "same_universe_equal_weight",
          "enum": [
            "BTCUSDT",
            "same_universe_equal_weight",
            "cash"
          ],
          "title": "Benchmark",
          "type": "string"
        },
        "annualization": {
          "const": 365,
          "default": 365,
          "title": "Annualization",
          "type": "integer"
        },
        "risk_free_rate": {
          "default": 0,
          "maximum": 0.5,
          "minimum": -0.1,
          "title": "Risk Free Rate",
          "type": "number"
        },
        "classification": {
          "default": "OWNER_RESEARCH",
          "enum": [
            "OWNER_RESEARCH",
            "SYNTHETIC_TEST"
          ],
          "title": "Classification",
          "type": "string"
        }
      },
      "required": [
        "strategy_id",
        "manifest_id",
        "source_as_of",
        "start",
        "end"
      ],
      "title": "BacktestDefinition",
      "type": "object"
    },
    "BacktestManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "backtest_manifest_v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "manifest_id": {
          "format": "uuid",
          "title": "Manifest Id",
          "type": "string"
        },
        "source_as_of": {
          "format": "date-time",
          "title": "Source As Of",
          "type": "string"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "code_hash": {
          "title": "Code Hash",
          "type": "string"
        },
        "detector_code_hash": {
          "title": "Detector Code Hash",
          "type": "string"
        },
        "feature_code_hash": {
          "title": "Feature Code Hash",
          "type": "string"
        },
        "calendar_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Calendar Versions",
          "type": "object"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "definition_hash": {
          "title": "Definition Hash",
          "type": "string"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        }
      },
      "required": [
        "source_hash",
        "manifest_id",
        "source_as_of",
        "engine_version",
        "code_hash",
        "detector_code_hash",
        "feature_code_hash",
        "calendar_versions",
        "environment",
        "definition_hash",
        "input_hash"
      ],
      "title": "BacktestManifest",
      "type": "object"
    },
    "BacktestRun": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "const": "completed",
          "default": "completed",
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/BacktestDefinition"
        },
        "manifest": {
          "$ref": "#/$defs/BacktestManifest"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "title": "Decisions",
          "type": "array"
        },
        "trades": {
          "items": {
            "$ref": "#/$defs/SimulatedTrade"
          },
          "title": "Trades",
          "type": "array"
        },
        "equity": {
          "items": {
            "$ref": "#/$defs/EquityPoint"
          },
          "title": "Equity",
          "type": "array"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "drawdown": {
          "additionalProperties": true,
          "title": "Drawdown",
          "type": "object"
        },
        "regime_performance": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Regime Performance",
          "type": "array"
        },
        "controls": {
          "additionalProperties": true,
          "title": "Controls",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "result_hash": {
          "title": "Result Hash",
          "type": "string"
        },
        "elapsed_ms": {
          "title": "Elapsed Ms",
          "type": "number"
        }
      },
      "required": [
        "run_id",
        "created_at",
        "definition",
        "manifest",
        "decisions",
        "trades",
        "equity",
        "metrics",
        "drawdown",
        "regime_performance",
        "controls",
        "warnings",
        "result_hash",
        "elapsed_ms"
      ],
      "title": "BacktestRun",
      "type": "object"
    },
    "CompareRequest": {
      "additionalProperties": false,
      "properties": {
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Run Ids",
          "type": "array"
        }
      },
      "required": [
        "run_ids"
      ],
      "title": "CompareRequest",
      "type": "object"
    },
    "CostModel": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "bps_proxy_v1",
          "default": "bps_proxy_v1",
          "title": "Version",
          "type": "string"
        },
        "entry_fee_bps": {
          "default": 10,
          "maximum": 500,
          "minimum": 0,
          "title": "Entry Fee Bps",
          "type": "number"
        },
        "exit_fee_bps": {
          "default": 10,
          "maximum": 500,
          "minimum": 0,
          "title": "Exit Fee Bps",
          "type": "number"
        },
        "slippage_bps": {
          "default": 5,
          "maximum": 500,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        },
        "spread_bps": {
          "default": 0,
          "maximum": 500,
          "minimum": 0,
          "title": "Spread Bps",
          "type": "number"
        },
        "fixed_fee": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Fixed Fee",
          "type": "number"
        }
      },
      "title": "CostModel",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "session": {
          "format": "date",
          "title": "Session",
          "type": "string"
        },
        "cutoff": {
          "format": "date-time",
          "title": "Cutoff",
          "type": "string"
        },
        "candidate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "state": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "enter": {
          "title": "Enter",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "evidence_hash": {
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "session",
        "cutoff",
        "outcome",
        "status",
        "enter",
        "reason",
        "observation_ids",
        "evidence_hash"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EdgeEvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "format": "uuid",
          "title": "Edge Id",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
